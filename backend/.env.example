ENV=development                 # production => SECRET_KEY lemah ditolak saat start
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
DB_ECHO=false

SECRET_KEY=ganti-dengan-hasil-perintah-di-bawah
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=access_token
COOKIE_SECURE=false             # produksi: true
COOKIE_SAMESITE=lax             # lintas domain tanpa proxy: none (wajib COOKIE_SECURE=true)

CORS_ORIGINS=http://localhost:3000

ARTIFACT_DIR=artifacts          # folder induk
MODEL_VERSION=v1                # artefak dibaca dari artifacts/v1

GEOCODING_USER_AGENT=basarnas-landslide-classifier
GEOCODING_TIMEOUT=2
GEOCODING_MIN_INTERVAL=1